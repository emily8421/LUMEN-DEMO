# LUMEN LLM 配置模板
#
# 用法：复制本文件为 `.env`（已 gitignore，不入库），填入 LLM_API_KEY，按需切换 LLM_PROVIDER。
# 后端通过 backend/service/llm_adapter.py 读取以下变量；未配置或 provider=mock 时走降级（不调 LLM）。
# 真实问答验证：配好后重启后端，调 POST /api/query。

# LLM 提供方：glm（默认）/ gpt / local（本机 ollama）/ mock（不调 LLM，降级）
LLM_PROVIDER=glm

# OpenAI 兼容 endpoint。不设则用 provider 默认值（见 llm_adapter._PROVIDER_DEFAULTS）：
#   glm/gpt → http://47.107.134.2:7777/v1（中转站，HTTP 明文）
#   local   → http://localhost:11434/v1（ollama，需本机先 ollama pull 模型）
# LLM_BASE_URL=http://47.107.134.2:7777/v1

# 模型名。不设则用 provider 默认：glm=glm-5.2 / gpt=gpt5.5 / local=qwen2.5:3b
# LLM_MODEL=glm4.7

# API key（provider 非 mock 时必填；local ollama 不校验，随意填如 "ollama"）
# ⚠️ 切勿提交真实 key 到仓库；只写在 .env（已 gitignore）。
LLM_API_KEY=填入你的中转站key

# --- 多配置格式（推荐，⑪ 部署 / 维护态批3 起）---
# LLM_PROVIDERS=deepseek_a,glm_a,gpt   # 第一个为默认
# LLM_DEEPSEEK_A_PROVIDER=deepseek
# LLM_DEEPSEEK_A_BASE_URL=http://192.168.15.190:7777/v1
# LLM_DEEPSEEK_A_MODEL=deepseek-v4-flash
# LLM_DEEPSEEK_A_API_KEY=你的key
# LLM_GLM_A_PROVIDER=glm
# LLM_GLM_A_BASE_URL=http://47.107.134.2:7777/v1
# LLM_GLM_A_MODEL=glm-5.2
# LLM_GLM_A_API_KEY=你的key

# PostgreSQL + pgvector（Sprint-8 / task-008 T1）。
# 本地先 docker compose -f docker/compose.yml up -d 起 lumen-pg 容器，再启动后端。
# 默认连 compose 起的容器（localhost:15432，库/用户/密码均为 lumen）。
DATABASE_URL=postgresql://lumen:lumen@localhost:15432/lumen

# 生产部署（docker-compose.prod.yml）：
#   - compose 用 env_file: .env 透传全部 LLM_* 变量；
#   - DATABASE_URL 会被 compose 覆盖为容器内 postgres:5432（无需在此改）；
#   - 建议设置 LUMEN_PG_PASSWORD=强密码（生产 PG 密码，compose 读取）。
